# Copy to .env on development machines or set these in systemd on the Pi.
TILLWEB_BASE_URL=https://tillweb.example.org
TILLWEB_KIOSK_TOKEN=replace-me
KIOSK_LOCATION=SpaceBAR
KIOSK_LISTEN_HOST=127.0.0.1
KIOSK_PORT=8080

# Printing is enabled by default. Set to false for development.
KIOSK_PRINT_ENABLED=true
# Optional CUPS printer name. Leave blank to use the default printer.
KIOSK_PRINTER_NAME=
# Use lp or lpr.
KIOSK_PRINT_COMMAND=lp
# OMS server URL. Required for remote/unattended operation — printer errors are
# POSTed to /api/printer-alert so the OMS staff screen can alert bar staff.
# Requires camp-network → VLAN routing to Luke's server. Confirm at setup.
KIOSK_OMS_URL=
# USB device path for ESC/POS hardware status queries (paper-out, cover-open,
# ribbon error). Enables DLE EOT pre-print check that CUPS/lpstat cannot detect.
# Typical value: /dev/usb/lp0  — find yours with: ls /dev/usb/lp*
# Requires the kiosk user to be in the `lp` group: sudo usermod -a -G lp $USER
# Leave blank to skip hardware check (CUPS-only detection remains active).
KIOSK_PRINTER_DEVICE=

# Development only: serve sample stock/order responses without contacting tillweb.
KIOSK_MOCK_MODE=false
# Show each product's real tillweb stocktype logo image instead of the bobbing
# low-poly 3D model. Use this on weak-GPU Pis (e.g. Pi 3) where WebGL is too
# slow or unavailable — the kiosk skips creating a WebGL context entirely.
# products.json's per-item `image` override still takes priority when set.
KIOSK_USE_STOCK_IMAGES=false
# Development only: log receipt details to console and write ESC/POS binary to
# /tmp/kiosk-receipt-{ref}.bin instead of (or in addition to) sending to the printer.
# Automatically active when KIOSK_MOCK_MODE=true and KIOSK_PRINT_ENABLED=true.
KIOSK_DUMMY_PRINT=false
