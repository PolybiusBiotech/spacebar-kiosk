# Copy to .env on development machines or set these in systemd on the Pi.
TILLWEB_BASE_URL=https://tillweb.example.org
TILLWEB_KIOSK_TOKEN=replace-me
KIOSK_LOCATION=spacebar
KIOSK_LISTEN_HOST=127.0.0.1
KIOSK_PORT=8080

# Printing is enabled by default. Set to false for development.
KIOSK_PRINT_ENABLED=true
# Optional CUPS printer name. Leave blank to use the default printer.
KIOSK_PRINTER_NAME=
# Use lp or lpr.
KIOSK_PRINT_COMMAND=lp
# OMS server URL. Required for remote/unattended operation — printer errors are
# POSTed to /api/printer-alert so the OMS staff screen can alert bar staff.
# Requires camp-network → VLAN routing to Luke's server. Confirm at setup.
KIOSK_OMS_URL=

# Development only: serve sample stock/order responses without contacting tillweb.
KIOSK_MOCK_MODE=false
